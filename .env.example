# ========================================
# CONFIGURATION STRIPE
# ========================================
# Clés API Stripe (à obtenir sur https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_votre_cle_secrete_stripe

# Webhook Stripe (à obtenir sur https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_votre_webhook_secret

# ========================================
# CONFIGURATION SENDGRID
# ========================================
# Clé API SendGrid (à obtenir sur https://app.sendgrid.com/settings/api_keys)
SENDGRID_API_KEY=SG.votre_cle_api_sendgrid

# Email expéditeur (doit être vérifié dans SendGrid)
SENDGRID_FROM_EMAIL=noreply@votre-domaine.com

# ========================================
# CONFIGURATION ADMIN
# ========================================
# Email de l'administrateur
ADMIN_EMAIL=admin@example.com

# Hash du mot de passe admin (généré avec bcrypt)
ADMIN_PASSWORD_HASH=$2b$10$votre_hash_bcrypt

# Secret pour signer les JWT
JWT_SECRET=votre-secret-jwt-changez-en-production

# ========================================
# CONFIGURATION VERCEL
# ========================================
# URL du front-end Angular
FRONTEND_URL=https://votre-site.vercel.app

# ========================================
# INSTRUCTIONS DE CONFIGURATION
# ========================================
# 1. Copier ce fichier vers .env
# 2. Remplacer les valeurs par vos vraies clés
# 3. Ne JAMAIS commiter .env dans Git (déjà dans .gitignore)
# 4. Sur Vercel, ajouter TOUTES ces variables dans Settings > Environment Variables
