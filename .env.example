# ========================================
# CONFIGURATION STRIPE
# ========================================
# Clés API Stripe (à obtenir sur https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_votre_cle_secrete_stripe
STRIPE_PUBLISHABLE_KEY=pk_test_votre_cle_publique_stripe

# Webhook Stripe (à obtenir sur https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_votre_webhook_secret

# ========================================
# CONFIGURATION VERCEL
# ========================================
# URL de production du site
NEXT_PUBLIC_SITE_URL=https://votre-site.vercel.app

# ========================================
# INSTRUCTIONS DE CONFIGURATION
# ========================================
# 1. Copier ce fichier vers .env.local
# 2. Remplacer les valeurs par vos vraies clés Stripe
# 3. Ne JAMAIS commiter .env.local dans Git
# 4. Sur Vercel, ajouter ces variables dans Settings > Environment Variables
